# TradingIntel Root Environment Variables
# Copy this file to .env and fill in your values
# This file is used by docker-compose

# ============================================================
# DATABASE (auto-configured for Docker; change for production)
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/tradingintel

# ============================================================
# ANTHROPIC (Claude AI)
# Get your key at: https://console.anthropic.com/
# ============================================================
ANTHROPIC_API_KEY=sk-ant-api...

# ============================================================
# GUPSHUP WhatsApp BSP
# Get credentials from: https://www.gupshup.io/
# ============================================================
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_APP_NAME=TradingIntel
GUPSHUP_SOURCE_NUMBER=917XXXXXXXXX

# ============================================================
# POSTMARK (Email delivery)
# Get your token at: https://postmarkapp.com/
# ============================================================
POSTMARK_API_KEY=your_postmark_server_token
POSTMARK_FROM_EMAIL=alerts@tradingintel.in

# ============================================================
# RAZORPAY (Payments)
# Get credentials from: https://dashboard.razorpay.com/
# ============================================================
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================================
# APPLICATION
# ============================================================
FRONTEND_URL=http://localhost:3000
SECRET_KEY=generate-a-secure-64-char-hex-string-for-production
ENVIRONMENT=development
DEBUG=true

# ============================================================
# FRONTEND (Next.js)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
